{
  "name": "glyphmark",
  "version": "0.1.0",
  "description": "Convert Pathfinder 2e markdown to styled HTML",
  "type": "module",
  "bin": {
    "glyphmark": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "pathfinder",
    "pf2e",
    "ttrpg",
    "markdown",
    "html"
  ],
  "license": "MIT",
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
