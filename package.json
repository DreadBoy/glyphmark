{
  "name": "glyphmark",
  "version": "0.1.0",
  "description": "Convert Pathfinder 2e scribe markup to styled HTML",
  "type": "module",
  "main": "./dist/pipeline.js",
  "exports": {
    ".": "./dist/pipeline.js"
  },
  "bin": {
    "glyphmark": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:update-goldens": "UPDATE_SNAPSHOTS=1 node --import tsx --test test/visual/visual.test.ts",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "pathfinder",
    "pf2e",
    "ttrpg",
    "markdown",
    "html",
    "scribe"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
