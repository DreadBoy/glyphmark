<!-- https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.glyphmark.intellij</id>
    <name>Glyphmark</name>
    <vendor>Glyphmark</vendor>
    <description><![CDATA[
        <p>Live preview for <code>.glyph</code> files.</p>
        <p>Opens Glyph markup in a source/preview split editor and renders it with
        the Glyphmark engine, styled to look like a page from the Pathfinder 2e
        rulebooks — the same output the Glyphmark CLI produces.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Glyph"
            language="TEXT"
            extensions="glyph"
            implementationClass="com.glyphmark.intellij.GlyphFileType"
            fieldName="INSTANCE"/>
        <fileEditorProvider implementation="com.glyphmark.intellij.GlyphEditorWithPreviewProvider"/>
    </extensions>
</idea-plugin>
