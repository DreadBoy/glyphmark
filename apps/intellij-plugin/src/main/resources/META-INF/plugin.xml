<!-- https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.glyphmark.intellij</id>
    <name>Glyphmark</name>
    <vendor>Glyphmark</vendor>
    <description><![CDATA[
        <p>Live preview and structure view for <code>.glyph</code> files.</p>
        <p>Opens Glyph markup in a source/preview split editor and renders it with
        the Glyphmark engine, styled to look like a page from the Pathfinder 2e
        rulebooks — the same output the Glyphmark CLI produces.</p>
        <p>The Structure tool window outlines the document: headings nested by
        level, plus <code>item</code>, <code>info</code>, <code>rule</code>,
        <code>sample</code> and <code>head</code> blocks under the heading they
        belong to.</p>
        <p>Editing actions under <em>Edit | Glyph</em> and the editor's context
        menu toggle bold, italic, superscript and subscript, and pressing Enter
        inside a list carries the bullet onto the next line.</p>
        <p>The preview panel has a toolbar for zooming, fitting the page to the
        panel width, jumping to a page, refreshing, and turning off the scroll
        sync that otherwise keeps the preview on the part of the document the
        editor is showing. The settings are remembered per file.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <!-- The preview renders in a JCEF browser. Up to build 252 the JCEF classes
         were reachable from every plugin's class loader, so no declaration was
         needed; from 262 they only live in the `intellij.platform.ui.jcef`
         content module of the bundled JCEF plugin, and without this dependency
         `JBCefApp` fails to load and the editor provider — hence the whole
         `.glyph` tab — dies on open. The module name resolves on 252 as well,
         so this stays compatible with the declared since-build. -->
    <dependencies>
        <module name="intellij.platform.ui.jcef"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <!-- No `language` attribute: GlyphFileType is a *secondary* file type
             for plain text (PlainTextFileType is the primary one), and the
             platform requires the attribute to be absent for those. -->
        <fileType
            name="Glyph"
            extensions="glyph"
            implementationClass="com.glyphmark.intellij.GlyphFileType"
            fieldName="INSTANCE"/>
        <!-- Syntax highlighting. `lang.syntaxHighlighterFactory` is keyed by
             Language, which GlyphFileType deliberately does not have, so the
             file-type-keyed equivalent is what applies here. -->
        <editorHighlighterProvider
            filetype="Glyph"
            implementationClass="com.glyphmark.intellij.GlyphEditorHighlighterProvider"/>
        <colorSettingsPage implementation="com.glyphmark.intellij.GlyphColorSettingsPage"/>
        <fileEditorProvider implementation="com.glyphmark.intellij.GlyphEditorWithPreviewProvider"/>
        <enterHandlerDelegate implementation="com.glyphmark.intellij.GlyphEnterHandler"/>
        <actionPromoter implementation="com.glyphmark.intellij.GlyphActionPromoter"/>
    </extensions>

    <actions>
        <!-- One group, shown in two places: under Edit for discoverability and
             on the editor's context menu for reach. Every action hides itself
             outside `.glyph` files, so the group collapses to nothing
             elsewhere. -->
        <group id="Glyphmark.MarkupActions" text="Glyph" popup="true">
            <add-to-group group-id="EditMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>

            <action id="Glyphmark.Strong"
                    class="com.glyphmark.intellij.GlyphStrongAction"
                    text="Bold"
                    description="Wrap the selection in ** **, or unwrap it">
                <!-- `$default` only: the macOS keymap rewrites Ctrl to meta, so
                     a separate `Mac OS X 10.5+` entry would be redundant. Go to
                     Declaration holds the same keystroke and wins on ordering
                     alone, so GlyphActionPromoter is what actually makes this
                     binding take effect. -->
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl B"/>
            </action>
            <action id="Glyphmark.Em"
                    class="com.glyphmark.intellij.GlyphEmAction"
                    text="Italic"
                    description="Wrap the selection in * *, or unwrap it">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl I"/>
            </action>
            <action id="Glyphmark.Superscript"
                    class="com.glyphmark.intellij.GlyphSuperscriptAction"
                    text="Superscript"
                    description="Wrap the selection in ^ ^, or unwrap it"/>
            <action id="Glyphmark.Subscript"
                    class="com.glyphmark.intellij.GlyphSubscriptAction"
                    text="Subscript"
                    description="Wrap the selection in ~ ~, or unwrap it"/>
        </group>
    </actions>
</idea-plugin>
