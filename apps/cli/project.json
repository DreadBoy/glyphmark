{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cli/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/cli/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/apps/cli"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/cli/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["^build"]
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/cli/cli.js",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["build"]
    }
  }
}
