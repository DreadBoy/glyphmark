            }
          ],
          "indent": "none",
          "kind": "paragraph",
          "origin": {
            "startLine": 112,
            "endLine": 112,
            "startOffset": 3497,
            "endOffset": 3505
          }
        },
        {
          "content": [
            {
              "kind": "text",
              "text": "Darkvision"
            }
          ],
          "kind": "heading",
          "level": 1,
          "origin": {
            "startLine": 114,
            "endLine": 114,
            "startOffset": 3507,
            "endOffset": 3519
          }
        },
        {
          "content": [
            {
              "kind": "text",
              "text": "You can see in darkness and dim light just as well as you can see in bright light, though your vision in darkness is in black and white."
            }
          ],
          "indent": "none",
          "kind": "paragraph",
          "origin": {
            "startLine": 116,
            "endLine": 117,
            "startOffset": 3521,
            "endOffset": 3657
          }
        },
        {
          "content": [
            {
              "kind": "text",
              "text": "Clan Dagger"
            }
          ],
          "kind": "heading",
          "level": 1,
          "origin": {
            "startLine": 119,
            "endLine": 119,
            "startOffset": 3659,
            "endOffset": 3672
          }
        },
        {
          "content": [
            {
              "kind": "text",
              "text": "You get one clan dagger (page 277) for free, as it was given to you at birth. Selling this clan dagger is a terrible taboo and earns you the disdain of other dwarves."
            }
          ],
          "indent": "none",
          "kind": "paragraph",
          "origin": {
            "startLine": 121,
            "endLine": 123,
            "startOffset": 3674,
            "endOffset": 3840
          }
        }
      ],
      "origin": {
        "startLine": 72,
        "endLine": 124,
