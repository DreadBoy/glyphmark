    },
    {
      "indent": "block",
      "items": [
        [
          {
            "children": [
              {
                "kind": "text",
                "text": "Decipher Writing"
              }
            ],
            "kind": "strong"
          },
          {
            "kind": "text",
            "text": " (page 228) of a religious nature, including allegories, homilies, and proverbs."
          }
        ],
        [
          {
            "children": [
              {
                "kind": "text",
                "text": "Identify Magic"
              }
            ],
            "kind": "strong"
          },
          {
            "kind": "text",
            "text": " (page 230), particularly magic of the divine tradition."
          }
        ],
        [
          {
            "children": [
              {
                "kind": "text",
                "text": "Learn a Spell"
              }
            ],
            "kind": "strong"
          },
          {
            "kind": "text",
            "text": " (page 230) from the divine tradition."
          }
        ]
      ],
