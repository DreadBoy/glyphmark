        "endOffset": 587
      },
      "type": "heading"
    },
    {
      "content": [
        {
          "kind": "text",
          "text": "You must be trained in Religion to use it for the following general skill actions."
        }
      ],
      "indent": "none",
      "origin": {
        "startLine": 9,
        "endLine": 9,
        "startOffset": 589,
        "endOffset": 671
      },
