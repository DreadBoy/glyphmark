{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/core/src",
  "projectType": "library",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -w -p libs/core/tsconfig.json"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/core/tsconfig.json"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/core/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/core/vitest.config.ts --exclude 'libs/core/test/visual/**'",
        "cwd": "{workspaceRoot}"
      }
    },
    "test:visual": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/core/vitest.config.ts libs/core/test/visual/visual.test.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "test:update-goldens": {
      "executor": "nx:run-commands",
      "options": {
        "command": "UPDATE_SNAPSHOTS=1 vitest run --config libs/core/vitest.config.ts libs/core/test/visual/visual.test.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
