{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "paths": {
      "@glyphmark/cli": ["./apps/cli/src/cli.ts"],
      "@glyphmark/core": ["./libs/core/src/index.ts"]
    }
  }
}
